{
  "schemaVersion": 1,
  "id": "tweakery",
  "version": "${version}",
  "name": "Tweakery",
  "description": "Tweakery is a lightweight client-side mod for tweaking Minecraft.",
  "authors": [
    "Ruineko"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/tweakery",
    "issues": "https://github.com/ruinelia/tweakery/issues",
    "sources": "https://github.com/ruinelia/tweakery"
  },
  "license": "MIT",
  "icon": "assets/tweakery/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.ruineko.tweakery.client.TweakeryClient"
    ],
    "main": [
      "com.ruineko.tweakery.Tweakery"
    ]
  },
  "mixins": [
    "tweakery.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "yet_another_config_lib_v3": ">=3.8.2"
  }
}
